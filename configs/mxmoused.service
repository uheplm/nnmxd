[Unit]
Description=mxmoused — Logitech MX Master 3/3S thumb button daemon for niri
# logid is a soft dependency: mxmoused runs without it, but the logid: action
# prefix only works when logid is alive. Order-after only, no Requires.
After=multi-user.target logid.service
Wants=logid.service

[Service]
Type=simple
ExecStart=/home/naudachu/.local/bin/mxmoused --config /home/naudachu/.config/mxmoused/config.yaml
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
